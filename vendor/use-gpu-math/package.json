{
  "name": "@use-gpu/math",
  "version": "0.21.0-rc.3",
  "main": "./cjs/index.cjs",
  "author": "Steven Wittens <steven@acko.net>",
  "module": "./mjs/index.mjs",
  "exports": {
    ".": {
      "types": "./mjs/index.d.mts",
      "import": "./mjs/index.mjs",
      "require": "./cjs/index.cjs"
    }
  },
  "license": "MIT",
  "scripts": {
    "test": "MODULE_ENV=cjs jest --watch",
    "lint": "eslint src",
    "coverage": "echo 'jest --collect-coverage' disabled",
    "types": "tsc --noEmit",
    "types:watch": "yarn run types -- --watch",
    "build": "NPM_PACKAGE=math ../../scripts/build-mjs-cjs.sh"
  },
  "keywords": [
    "use-gpu",
    "use-gpu-library"
  ],
  "sideEffects": false
}
