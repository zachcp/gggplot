  "scripts": {
    "test": "vitest --watch",
    "lint": "eslint src",
    "coverage": "vitest --coverage",
    "types": "tsc --noEmit",
    "types:watch": "yarn run types -- --watch",
    "build": "yarn run build:ts; yarn run build:exports-ts; yarn run build:pkg; yarn run build:cjs; yarn run build:mjs; yarn run build:exports-js; yarn run build:ts-out",
    "build:pkg": "rm -rf ../../build/packages/wgsl 2>/dev/null; mkdir -p ../../build/packages/wgsl && cp README.md package.json ../../build/packages/wgsl; NPM_PACKAGE=wgsl tsx ../../scripts/package-json-version.ts",
    "build:ts": "../shader/bin/shader2ts.mjs --output ./src --basePath ./wgsl --importRoot @use-gpu/wgsl --input ./wgsl --types --exports --sourceMap",
    "build:cjs": "../shader/bin/shader2ts.mjs --output ../../build/packages/wgsl/cjs --basePath ./wgsl --importRoot @use-gpu/wgsl --input ./wgsl --minify --typeDef --cjs --sourceMap",
    "build:mjs": "../shader/bin/shader2ts.mjs --output ../../build/packages/wgsl/mjs --basePath ./wgsl --importRoot @use-gpu/wgsl --input ./wgsl --minify --typeDef --sourceMap",
    "build:exports-ts": "tsx --tsconfig ../../tsconfig.json scripts/exports-ts.ts",
    "build:exports-js": "tsx --tsconfig ../../tsconfig.json scripts/exports-js.ts",
    "build:ts-out": "rm -rf ../../build/ts/wgsl 2>/dev/null; mkdir -p ../../build/ts/wgsl; cp -r ../../build/packages/wgsl/cjs ../../build/ts/wgsl/src",
    "watch": "npm-watch",
    "dev": "yarn run build; yarn run watch"
  },
  "watch": {
    "build:ts": {
      "patterns": [
        "wgsl/**/*"
      ],
      "extensions": "wgsl",
      "quiet": false
    }
  },
