#!/usr/bin/env bash
set -euo pipefail

readonly DENO_VERSION="2.8.0"
readonly DENO_INSTALL="${DENO_INSTALL:-$HOME/.deno}"
export DENO_INSTALL
export PATH="$DENO_INSTALL/bin:$HOME/.local/bin:$PATH"

step() {
  local label="$1"
  shift
  local started=$SECONDS
  printf '\n==> %s\n' "$label"
  "$@"
  printf '    completed in %ss\n' "$((SECONDS - started))"
}

install_deno() {
  local installed=""
  if command -v deno >/dev/null 2>&1; then
    installed="$(deno --version | awk 'NR == 1 { print $2 }')"
  fi

  if [[ "$installed" == "$DENO_VERSION" ]]; then
    printf 'Deno %s is already installed.\n' "$DENO_VERSION"
    return
  fi

  curl -fsSL https://deno.land/install.sh | sh -s -- "v$DENO_VERSION"
}

install_beads() {
  local version="1.2.2"
  local installed=""
  if command -v bd >/dev/null 2>&1; then
    installed="$(bd version | awk 'NR == 1 { print $3 }')"
  fi
  if [[ "$installed" == "$version" ]]; then
    printf 'bd %s is already installed.\n' "$version"
    return
  fi

  local arch archive checksum
  case "$(uname -m)" in
    x86_64)
      arch="amd64"
      checksum="8140098a51d3b81d5548d1c5e6db1a2d9930e5d141efe2a4bff7d079c4d321e8"
      ;;
    aarch64 | arm64)
      arch="arm64"
      checksum="501f38a1070d4b9b3b6261a86a3c92c4a52366869021560430a4bb0036afd83a"
      ;;
    *)
      printf 'Unsupported Beads architecture: %s\n' "$(uname -m)" >&2
      return 1
      ;;
  esac
  archive="beads_${version}_linux_${arch}.tar.gz"
  (
    tmp="$(mktemp -d "${TMPDIR:-/tmp}/gggplot-beads.XXXXXX")"
    trap 'rm -rf "$tmp"' EXIT
    curl -fsSL \
      "https://github.com/gastownhall/beads/releases/download/v${version}/${archive}" \
      -o "$tmp/$archive"
    printf '%s  %s\n' "$checksum" "$tmp/$archive" |
      sha256sum --check --status
    tar -xzf "$tmp/$archive" -C "$tmp" bd
    install -Dm755 "$tmp/bd" "$HOME/.local/bin/bd"
  )
}

configure_login_shell() {
  local marker="# gggplot orb toolchain"
  touch "$HOME/.bash_profile"
  if grep -Fqx "$marker" "$HOME/.bash_profile"; then
    return
  fi

  cat >> "$HOME/.bash_profile" <<'EOF'

# gggplot orb toolchain
export DENO_INSTALL="$HOME/.deno"
export PATH="$DENO_INSTALL/bin:$HOME/.local/bin:$PATH"
EOF
}

install_dependencies() {
  deno install --frozen
}

install_chromium() {
  if find "$HOME/.cache/ms-playwright" -type f \
    \( -name chrome -o -name headless_shell \) -executable -print -quit \
    2>/dev/null | grep -q .; then
    deno run -A npm:playwright@^1.61.1 install chromium
  else
    deno run -A npm:playwright@^1.61.1 install --with-deps chromium
  fi
}

step "Install Deno" install_deno
step "Install Beads" install_beads
step "Bootstrap Beads database" "$PWD/scripts/bootstrap_beads.sh"
step "Configure login shells" configure_login_shell
step "Install locked dependencies" install_dependencies
step "Install Playwright Chromium" install_chromium

printf '\nOrb setup complete.\n'
