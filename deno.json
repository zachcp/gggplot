{
  "workspace": [
    "packages/core",
    "packages/model-inspect",
    "packages/reductions",
    "apps/site"
  ],
  "nodeModulesDir": "auto",
  // TEMPORARY shim for Use.GPU 0.21.0 (gggplot-79z5): @use-gpu/math is
  // published without an "exports" map, so Node/Deno load its CommonJS build
  // and @use-gpu/glyph's ESM `import { sqr } from '@use-gpu/math'` fails to
  // link. vendor/use-gpu-math is the npm tarball unchanged except for that
  // map. Delete this entry and vendor/use-gpu-math once a published release
  // ships math with an "exports" map (gggplot-i879, vendor/README.md).
  // WGSL 0.21.0 also needs a CommonJS boundary for its cjs/*.js files.
  "links": ["./vendor/use-gpu-math", "./vendor/use-gpu-wgsl"],
  "fmt": {
    "exclude": [
      "vendor/",
      ".beads/",
      ".claude/",
      ".agents/",
      "apps/site/.artifacts/",
      "packages/core/tests/fixtures/",
      "packages/model-inspect/tests/fixtures/",
      "docs/GRIBOUILLE_PARITY_MATRIX.md",
      "docs/model_inspect_baseline.json"
    ]
  },
  "lint": {
    "exclude": [
      "vendor/",
      ".beads/",
      ".claude/",
      ".agents/",
      "apps/site/.artifacts/",
      "packages/core/tests/fixtures/",
      "packages/model-inspect/tests/fixtures/",
      "docs/GRIBOUILLE_PARITY_MATRIX.md",
      "docs/model_inspect_baseline.json"
    ]
  },
  "tasks": {
    "dev": "deno task --cwd apps/site dev",
    "build": "deno task --cwd apps/site build",
    "preview": "deno task --cwd apps/site preview",
    "check": "deno check packages/core/src/mod.ts && deno check packages/model-inspect/src/mod.ts && deno check packages/core/bench/ packages/reductions/bench/ && deno task --cwd apps/site check",
    "lint": "deno fmt --check && deno lint",
    "test": "deno test -A packages/core/tests/ packages/model-inspect/tests/ packages/reductions/tests/ apps/site/src/docs/",
    "check:core": "deno check packages/core/src/mod.ts",
    "check:site": "deno task --cwd apps/site check",
    "demo": "deno run -A packages/core/examples/emit-demo.ts",
    "gggplot": "deno run -A packages/core/src/cli.ts",
    "parity:matrix": "deno run -A scripts/generate_gribouille_parity_matrix.ts",
    "parity:check": "deno run -A scripts/generate_gribouille_parity_matrix.ts --check",
    "fixtures:capture": "deno run -A scripts/capture_geom_fixtures.ts",
    "fixtures:check": "deno run -A scripts/capture_geom_fixtures.ts --check",
    "model:perf": "deno run -A scripts/model_inspect_perf.ts",
    "model:perf:check": "deno run -A scripts/model_inspect_perf.ts --check"
  }
}
