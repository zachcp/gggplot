{
  "workspace": [
    "packages/core",
    "packages/model-inspect",
    "packages/reductions",
    "apps/site"
  ],
  "nodeModulesDir": "auto",
  "fmt": {
    "exclude": [
      ".beads/",
      ".claude/",
      ".agents/",
      "apps/site/.artifacts/",
      "packages/core/tests/fixtures/",
      "docs/GRIBOUILLE_PARITY_MATRIX.md"
    ]
  },
  "lint": {
    "exclude": [
      ".beads/",
      ".claude/",
      ".agents/",
      "apps/site/.artifacts/",
      "packages/core/tests/fixtures/",
      "docs/GRIBOUILLE_PARITY_MATRIX.md"
    ]
  },
  "tasks": {
    "dev": "deno task --cwd apps/site dev",
    "build": "deno task --cwd apps/site build",
    "preview": "deno task --cwd apps/site preview",
    "check": "deno check packages/core/src/mod.ts && deno check packages/model-inspect/src/mod.ts && deno task --cwd apps/site check",
    "lint": "deno fmt --check && deno lint",
    "test": "deno test -A packages/core/tests/ packages/model-inspect/tests/ packages/reductions/tests/ apps/site/src/docs/model_examples_test.ts apps/site/src/docs/model_asset_test.ts apps/site/src/docs/model_views_test.ts apps/site/src/docs/model_extensions_test.ts",
    "check:core": "deno check packages/core/src/mod.ts",
    "check:site": "deno task --cwd apps/site check",
    "demo": "deno run packages/core/examples/emit-demo.ts",
    "gggplot": "deno run -A packages/core/src/cli.ts",
    "parity:matrix": "deno run -A scripts/generate_gribouille_parity_matrix.ts",
    "parity:check": "deno run -A scripts/generate_gribouille_parity_matrix.ts --check",
    "fixtures:capture": "deno run -A scripts/capture_geom_fixtures.ts",
    "fixtures:check": "deno run -A scripts/capture_geom_fixtures.ts --check"
  }
}
